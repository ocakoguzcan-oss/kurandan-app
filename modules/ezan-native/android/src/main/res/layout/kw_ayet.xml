<?xml version="1.0" encoding="utf-8"?>
<!-- Günün Ayeti: sayfalar ViewFlipper'da 40 saniyede bir kendiliğinden değişir (iOS'taki gibi) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/kw_kok"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/kw_kart"
  android:padding="15dp">
  <ViewFlipper android:id="@+id/kw_cevirici" android:layout_width="match_parent" android:layout_height="match_parent"
    android:autoStart="true" android:flipInterval="40000"
    android:inAnimation="@android:anim/fade_in" android:outAnimation="@android:anim/fade_out" />
</FrameLayout>
