{
  "expo": {
    "name": "Kurandan",
    "slug": "kurandan-app",
    "scheme": "kurandan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F3ECDC"
    },
    "ios": {
      "bundleIdentifier": "ai.kurandan.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Namaz vakitlerini ve kıble yönünü bulunduğunuz yere göre hesaplamak için konumunuz kullanılır.",
        "NSPhotoLibraryAddUsageDescription": "Cuma görselini galerinize kaydetmek için izin gerekir.",
        "LSApplicationQueriesSchemes": ["instagram", "instagram-stories"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ai.kurandan.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F3ECDC"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-video",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Namaz vakitlerini ve kıble yönünü bulunduğunuz yere göre hesaplamak için konumunuz kullanılır."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#18583C"
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Cuma görselini galerinize kaydetmek için izin gerekir.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "./plugins/withInstagramQueries.js"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "reelsApiUrl": "",
      "facebookAppId": ""
    }
  }
}
