    },
    "locales": {
      "tr": "./locales/tr.json",
      "en": "./locales/en.json",
      "de": "./locales/de.json",
      "ar": "./locales/ar.json",
      "fr": "./locales/fr.json",
      "ru": "./locales/ru.json"
