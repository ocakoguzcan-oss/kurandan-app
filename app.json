{
  "expo": {
    "name": "Kurandan.ai",
    "slug": "kurandanapp",
    "scheme": "kurandan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "ai.kurandan.app",
      "supportsTablet": false,
      "appleTeamId": "34J4Q96FX6",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Namaz vakitlerini ve kıble yönünü bulunduğunuz yere göre hesaplamak için konumunuz kullanılır.",
        "NSPhotoLibraryAddUsageDescription": "Cuma görselini galerinize kaydetmek için izin gerekir.",
        "LSApplicationQueriesSchemes": [
          "instagram",
          "instagram-stories"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true,
        "NSAlarmKitUsageDescription": "Sabah ezanını, telefon sessizdeyken de duyabilmeniz için alarm olarak kurar.",
        "NSSupportsLiveActivities": true
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.ai.kurandan.app"
        ]
      }
    },
    "android": {
      "package": "ai.kurandan.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F3ECDC"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F3ECDC"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-font",
      "expo-video",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Namaz vakitlerini ve kıble yönünü bulunduğunuz yere göre hesaplamak için konumunuz kullanılır."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#18583C",
          "enableRemoteNotifications": false,
          "sounds": [
            "./assets/sounds/ezan_imsak.caf",
            "./assets/sounds/ezan_imsak_s4.caf",
            "./assets/sounds/ezan_imsak_orta.caf",
            "./assets/sounds/ezan_imsak_s2.caf",
            "./assets/sounds/ezan_imsak_dusuk.caf",
            "./assets/sounds/ezan_ogle.caf",
            "./assets/sounds/ezan_ogle_s4.caf",
            "./assets/sounds/ezan_ogle_orta.caf",
            "./assets/sounds/ezan_ogle_s2.caf",
            "./assets/sounds/ezan_ogle_dusuk.caf",
            "./assets/sounds/ezan_ikindi.caf",
            "./assets/sounds/ezan_ikindi_s4.caf",
            "./assets/sounds/ezan_ikindi_orta.caf",
            "./assets/sounds/ezan_ikindi_s2.caf",
            "./assets/sounds/ezan_ikindi_dusuk.caf",
            "./assets/sounds/ezan_aksam.caf",
            "./assets/sounds/ezan_aksam_s4.caf",
            "./assets/sounds/ezan_aksam_orta.caf",
            "./assets/sounds/ezan_aksam_s2.caf",
            "./assets/sounds/ezan_aksam_dusuk.caf",
            "./assets/sounds/ezan_yatsi.caf",
            "./assets/sounds/ezan_yatsi_s4.caf",
            "./assets/sounds/ezan_yatsi_orta.caf",
            "./assets/sounds/ezan_yatsi_s2.caf",
            "./assets/sounds/ezan_yatsi_dusuk.caf",
            "./assets/sounds/cuma_sala.caf",
            "./assets/sounds/cuma_sala_s4.caf",
            "./assets/sounds/cuma_sala_orta.caf",
            "./assets/sounds/cuma_sala_s2.caf",
            "./assets/sounds/cuma_sala_dusuk.caf",
            "./assets/sounds/ses_kisa1.caf",
            "./assets/sounds/ses_kisa2.caf",
            "./assets/sounds/ses_kisa3.caf",
            "./assets/sounds/ses_kanun.caf",
            "./assets/sounds/ses_ruzgar.caf",
            "./assets/sounds/ses_melodi1.caf",
            "./assets/sounds/ses_melodi2.caf",
            "./assets/sounds/ses_melodi3.caf",
            "./assets/sounds/ses_saat.caf",
            "./assets/sounds/ses_dingdong.caf",
            "./assets/sounds/ses_uyan.caf",
            "./assets/sounds/ses_yuksek.caf",
            "./assets/sounds/ses_kus.caf",
            "./assets/sounds/ses_bip.caf"
          ]
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Cuma görselini galerinize kaydetmek için izin gerekir.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "./plugins/withInstagramQueries.js",
      [
        "expo-image-picker",
        {
          "photosPermission": "Story görselinin arka planına fotoğraf koyabilmeniz için galerinize erişim gerekir.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "reelsApiUrl": "https://kurandan-app-server.vercel.app",
      "facebookAppId": "2376501199962705",
      "eas": {
        "projectId": "bb04fc89-875e-494a-b400-e32a0922aff6"
      },
      "supportsRTL": true,
      "revenuecatIosKey": "BURAYA_REVENUECAT_IOS_ANAHTARI",
      "revenuecatAndroidKey": "BURAYA_REVENUECAT_ANDROID_ANAHTARI"
    },
    "owner": "kurandanai",
