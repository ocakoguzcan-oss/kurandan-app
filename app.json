{
  "expo": {
    "name": "Kurandan",
    "slug": "kurandanapp",
    "scheme": "kurandan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "ai.kurandan.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Namaz vakitlerini ve kıble yönünü bulunduğunuz yere göre hesaplamak için konumunuz kullanılır.",
        "NSPhotoLibraryAddUsageDescription": "Cuma görselini galerinize kaydetmek için izin gerekir.",
        "LSApplicationQueriesSchemes": [
          "instagram",
          "instagram-stories"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ],
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "ai.kurandan.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F3ECDC"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F3ECDC"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-video",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Namaz vakitlerini ve kıble yönünü bulunduğunuz yere göre hesaplamak için konumunuz kullanılır."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#18583C",
          "sounds": [
            "./assets/sounds/ezan.wav"
          ]
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Cuma görselini galerinize kaydetmek için izin gerekir.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "./plugins/withInstagramQueries.js",
      [
        "expo-image-picker",
        {
          "photosPermission": "Story görselinin arka planına fotoğraf koyabilmeniz için galerinize erişim gerekir.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "reelsApiUrl": "https://kurandan-app-server.vercel.app",
      "facebookAppId": "2376501199962705",
      "eas": {
        "projectId": "bb04fc89-875e-494a-b400-e32a0922aff6"
      },
      "supportsRTL": true
    },
    "owner": "kurandanai",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/bb04fc89-875e-494a-b400-e32a0922aff6"
    },
    "locales": {
      "tr": "./locales/tr.json",
      "en": "./locales/en.json",
      "de": "./locales/de.json",
      "ar": "./locales/ar.json",
      "fr": "./locales/fr.json",
      "ru": "./locales/ru.json"
    }
  }
}